# Supabase — get from: Supabase Dashboard > Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Tooling/migrations only. Never import this variable into application code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# OpenRouter — get from: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Deriv API (new API at api.derivws.com)
# App ID — register at https://developers.deriv.com/
NEXT_PUBLIC_DERIV_APP_ID=your-app-id-here
# PAT — generate at Deriv account settings (needed for trading, not for charts)
DERIV_PAT=pat_your-token-here

# Brave Search API — get from: https://api.search.brave.com/
BRAVE_API_KEY=your-brave-api-key-here
